      "source": "theorem mathlib2_unit_of_natDegree_zero {k : Type*} [Field k]\n    (a : k[X]) (ha : a ≠ 0) (hz : a.natDegree = 0) : IsUnit a := by\n  apply isUnit_iff_degree_eq_zero.mpr\n  rw [degree_eq_natDegree ha, hz]\n  rfl\n",
